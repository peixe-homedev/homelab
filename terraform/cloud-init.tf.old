resource "proxmox_virtual_environment_file" "cloud_config" {
  content_type = "snippets"
  datastore_id = "local"
  node_name    = "pve"

  source_raw {
    file_name = "fileserver-config.yaml"
    data = <<EOF
#cloud-config
# 1. Mount the WD Cloud with SMB 3.0
mounts:
  - [ "//192.168.1.248/JPEIXE-WD", "/mnt/wd_cloud", "cifs", "username=${var.wd_username},password=${var.wd_password},iocharset=utf8,vers=3.0,noperm", "0", "0" ]

# 2. Finalize System Preparation
runcmd:
  - apt-get update
  - apt-get install -y cifs-utils
  - mkdir -p /mnt/wd_cloud
  - mount -a
  - fallocate -l 1G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
EOF
  }
}